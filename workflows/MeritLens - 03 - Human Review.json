      "name": "Review Input"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n    UPDATE candidate_assessments\n    SET\n        review_status = $2,\n        reviewer_notes = $3,\n        reviewed_at = CASE\n            WHEN $2 = 'reviewed' THEN NOW()\n            ELSE NULL\n        END\n    WHERE id = $1\n    RETURNING id, candidate_reference, review_status, reviewer_notes, reviewed_at\n)\nSELECT\n    EXISTS (SELECT 1 FROM updated) AS success,\n    (SELECT id FROM updated) AS assessment_id,\n    (SELECT review_status FROM updated) AS review_status;",
        "options": {
          "queryReplacement": "={{ [   $json.assessment_id,   $json.review_status,   $json.reviewer_notes ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        0
      ],
      "id": "3e046742-d5a1-4994-940c-99f2cdeb4b93",

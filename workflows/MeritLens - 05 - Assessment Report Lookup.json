      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "MeritLens — Assessment Report Lookup",
        "formDescription": "Enter an Assessment ID to retrieve the candidate's complete assessment report, job details, and human review status.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Assessment ID",

      "credentials": {
        "httpBasicAuth": {
          "id": "j5Wc5yluuG26GyhV",
          "name": "Assessment Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    ca.id AS assessment_id,\n    ca.candidate_reference,\n    ca.job_reference,\n    ca.job_title,\n    ca.assessment_report,\n    ca.review_status,\n    ca.reviewer_notes,\n    ca.created_at,\n    ca.reviewed_at,\n    (ca.id IS NOT NULL) AS found\nFROM (SELECT 1) AS input\nLEFT JOIN candidate_assessments ca\n    ON ca.id = $1;",
        "options": {
          "queryReplacement": "={{ [Number($json[\"Assessment ID\"])] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "cebe3c84-3d3a-4955-a824-8cd3f3386906",
      "name": "Get Assessment Report",
      "credentials": {
        "postgres": {
          "id": "PNORX2lhaxJUZQI0",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "={{ $json.found\n  ? `ASSESSMENT REPORT\n\nAssessment ID: ${$json.assessment_id}\nJob Reference: ${$json.job_reference}\nPosition: ${$json.job_title}\nReview Status: ${$json.review_status}\n\n--------------------------------\n\n${$json.assessment_report}\n\n--------------------------------\n\nReviewer Notes:\n${$json.reviewer_notes || 'No reviewer notes yet.'}`\n  : 'Assessment not found. Please check the Assessment ID and try again.'\n}}"
      },
      "type": "n8n-nodes-base.form",
